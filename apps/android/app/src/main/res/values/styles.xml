<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BudgetGuard" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#346347</item>
        <item name="android:statusBarColor">#F4F1E8</item>
        <item name="android:navigationBarColor">#191F1A</item>
    </style>

    <style name="BudgetGuardDrawerAnimation">
        <item name="android:windowEnterAnimation">@anim/drawer_slide_in</item>
        <item name="android:windowExitAnimation">@anim/drawer_slide_out</item>
    </style>

    <style name="BudgetGuardSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_slide_up</item>
        <item name="android:windowExitAnimation">@anim/sheet_slide_down</item>
    </style>
</resources>
